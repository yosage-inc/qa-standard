{
  "$comment": "各サイトのリポジトリ直下に qa-policy.json として置くとデフォルト判定ルールを上書きできる。無ければ classify-release.mjs 内蔵のデフォルトが使われる。ここは上書きしたい項目だけ書けばよい(thresholds はマージされる)。",
  "version": 1,
  "l0_paths": [
    "content/**", "posts/**", "articles/**", "data/**",
    "public/images/**", "src/content/**",
    "**/*.md", "**/*.mdx", "**/*.csv",
    "**/*.jpg", "**/*.jpeg", "**/*.png", "**/*.webp", "**/*.avif", "**/*.gif", "**/*.svg", "**/*.ico",
    "**/*.txt", "**/*.xml", "README*", "LICENSE*", "docs/**"
  ],
  "l2_paths": [
    "**/layouts/**", "**/templates/**", "**/components/**",
    "**/*.css", "**/*.scss", "**/tailwind.config.*", "**/astro.config.*", "**/vite.config.*",
    "build.py", "**/build.py"
  ],
  "l3_paths": [
    "**/auth/**", "**/login/**", "**/session*", "**/middleware*",
    "**/payment*", "**/billing*", "**/checkout*",
    "**/migrations/**", "**/*.sql", "**/schema*", "**/drizzle*",
    "package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock",
    "requirements*.txt", "uv.lock",
    "wrangler.toml", "wrangler.jsonc", "wrangler.json",
    ".github/**", "**/_headers", "**/headers*", "**/csp*", "**/*cookie*",
    ".env*", "**/secrets*"
  ],
  "l3_words": {
    "$comment": "パスを語に分けて語頭一致。stems で始まる語があれば L3、except の語(完全一致)は数えない。旧 **/*auth* の後継(author(s) に当たらない)",
    "stems": ["auth", "oauth", "unauth"],
    "except": ["author", "authors", "authored", "authoring", "authorial", "authorship"]
  },
  "thresholds": { "l1_max_files": 5, "l1_max_lines": 150 },
  "smoke_paths": ["/"]
}
